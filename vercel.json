{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "thanks.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/thanks",
      "dest": "/thanks.html"
    },
    {
      "src": "/",
      "dest": "/thanks.html"
    }
  ]
}